datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id            String         @id @default(auto()) @map("_id") @db.ObjectId
    name          String?
    email         String?        @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    subscriptions Subscription[] // Relation to user subscriptions
    projects      Project[] // Relation to projects created by the user

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    Authenticator Authenticator[]
}

model Account {
    id                String  @id @default(auto()) @map("_id") @db.ObjectId
    userId            String  @db.ObjectId
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.String
    access_token      String? @db.String
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.String
    session_state     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    sessionToken String   @unique
    userId       String   @db.ObjectId
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model VerificationToken {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    identifier String
    token      String
    expires    DateTime

    @@unique([identifier, token])
}

model Authenticator {
    credentialID         String  @id @map("_id")
    userId               String  @db.ObjectId
    providerAccountId    String
    credentialPublicKey  String
    counter              Int
    credentialDeviceType String
    credentialBackedUp   Boolean
    transports           String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, credentialID])
}

model Plan {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    name      String // Name of the plan (e.g., 'Daily', 'Weekly', 'Monthly', 'Yearly')
    price     Float // Price of the plan
    duration  String // Duration of the plan (e.g., 'day', 'week', 'month', 'year')
    maxUsage  Int? // Maximum number of translations allowed (optional)
    active    Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    Subscription Subscription[]
}

model Subscription {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    userId    String   @db.ObjectId
    planId    String   @db.ObjectId
    startDate DateTime @default(now())
    endDate   DateTime // When the subscription ends
    maxUsage  Int? // Maximum number of translations allowed (optional)
    uses      Int? // Number of translations used
    active    Boolean  @default(true)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

    @@unique([userId, planId, startDate])
}

model Project {
    id       String    @id @default(auto()) @map("_id") @db.ObjectId
    name     String // Name of the manga project
    userId   String    @db.ObjectId
    chapters Chapter[] // Relation to chapters in this project

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Chapter {
    id        String @id @default(auto()) @map("_id") @db.ObjectId
    title     String // Title of the chapter
    projectId String @db.ObjectId
    pages     Page[] // Relation to pages in this chapter

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Page {
    id                  String        @id @default(auto()) @map("_id") @db.ObjectId
    chapterId           String        @db.ObjectId
    originalImageUrl    String // URL or path to the original image
    maskImageUrl        String? // URL or path to the mask image if used
    deletedTextImageUrl String? // URL or path to the text-deleted image
    userEditedImageUrl  String? // URL or path to the final user-edited image
    textBlocks          TextBlock[] // Relation to text blocks detected in the image
    editedBlocks        EditedBlock[] // Relation to edited text blocks created by the user

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

    translatedBlock TranslatedBlock[]
}

model TextBlock {
    id           String @id @default(auto()) @map("_id") @db.ObjectId
    pageId       String @db.ObjectId
    text         String // Extracted text in this block
    font         String // Detected or default font
    textColor    String // Detected text color
    outlineColor String // Detected outline color
    x            Int // X-coordinate of the block in the image
    y            Int // Y-coordinate of the block in the image
    width        Int // Width of the text block
    height       Int // Height of the text block
    languageId   String @db.ObjectId // Reference to the language-specific default

    page     Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
    language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

    translatedBlock TranslatedBlock?
    EditedBlock     EditedBlock?
}

model TranslatedBlock {
    id           String    @id @default(auto()) @map("_id") @db.ObjectId
    pageId       String    @db.ObjectId
    text         String // Extracted text in this block
    font         String // Detected or default font
    textColor    String // Detected text color
    outlineColor String // Detected outline color
    x            Int // X-coordinate of the block in the image
    y            Int // Y-coordinate of the block in the image
    width        Int // Width of the text block
    height       Int // Height of the text block
    languageId   String    @db.ObjectId // Reference to the language-specific default
    textBlockId  String    @unique @db.ObjectId // Reference to the original text block
    page         Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
    language     Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)
    textBlock    TextBlock @relation(fields: [textBlockId], references: [id], onDelete: Cascade)
}

model EditedBlock {
    id           String    @id @default(auto()) @map("_id") @db.ObjectId
    pageId       String    @db.ObjectId
    text         String // Edited text in this block
    font         String // Edited font
    textColor    String // Edited text color
    outlineColor String // Edited outline color
    x            Int // X-coordinate of the block in the image
    y            Int // Y-coordinate of the block in the image
    width        Int // Width of the text block
    height       Int // Height of the text block
    languageId   String    @db.ObjectId // Reference to the language-specific default
    textBlockId  String    @unique @db.ObjectId // Reference to the original text block
    page         Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
    language     Language  @relation(fields: [languageId], references: [id], onDelete: Cascade)
    textBlock    TextBlock @relation(fields: [textBlockId], references: [id], onDelete: Cascade)
}

model Language {
    id                  String @id @default(auto()) @map("_id") @db.ObjectId
    code                String @unique // Language code (e.g., 'en', 'jp', 'kr')
    name                String // Full name of the language
    defaultFont         String // Default font for this language
    defaultTextColor    String // Default text color for this language
    defaultOutlineColor String // Default outline color for this language

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    textBlocks   TextBlock[] // Relation to text blocks using this language
    editedBlocks EditedBlock[] // Relation to edited blocks using this language

    translatedBlock TranslatedBlock[]
}
