datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id            String         @id @default(auto()) @map("_id") @db.ObjectId
    name          String?
    email         String?        @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    subscriptions Subscription[] // Relation to user subscriptions
    projects      Project[] // Relation to projects created by the user

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    Authenticator Authenticator[]
}

model Account {
    id                String  @id @default(auto()) @map("_id") @db.ObjectId
    userId            String  @db.ObjectId
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.String
    access_token      String? @db.String
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.String
    session_state     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    sessionToken String   @unique
    userId       String   @db.ObjectId
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model VerificationToken {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    identifier String
    token      String
    expires    DateTime

    @@unique([identifier, token])
}

model Authenticator {
    credentialID         String  @id @map("_id")
    userId               String  @db.ObjectId
    providerAccountId    String
    credentialPublicKey  String
    counter              Int
    credentialDeviceType String
    credentialBackedUp   Boolean
    transports           String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, credentialID])
}

model Pricing {
    id           String @id @default(auto()) @map("_id") @db.ObjectId
    planId       String @db.ObjectId
    pricePerUnit Float // Price per credit
    maxUsage     Int // Maximum number of translations
    plan         Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model Plan {
    id          String   @id @default(auto()) @map("_id") @db.ObjectId
    name        String // Name of the plan
    description String // Description of the plan
    duration    String? // 'one-time', 'month', 'year', etc.
    type        String // 'one-time' or 'recurring'
    features    String[] // List of features included in the plan
    active      Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    subscription Subscription[]
    pricing      Pricing[]
}

model Subscription {
    id        String    @id @default(auto()) @map("_id") @db.ObjectId
    userId    String    @db.ObjectId
    planId    String    @db.ObjectId
    startDate DateTime  @default(now())
    endDate   DateTime? // For recurring subscriptions
    maxUsage  Int // Maximum credits (one-time or recurring limit)
    uses      Int? // Number of translations used
    active    Boolean   @default(true)

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

    @@unique([userId, planId, startDate])
}

model Project {
    id       String    @id @default(auto()) @map("_id") @db.ObjectId
    name     String // Name of the manga project
    userId   String    @db.ObjectId
    chapters Chapter[] // Relation to chapters in this project

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Chapter {
    id        String @id @default(auto()) @map("_id") @db.ObjectId
    name      String // Title of the chapter
    projectId String @db.ObjectId
    pages     Page[] // Relation to pages in this chapter

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Page {
    id                  String        @id @default(auto()) @map("_id") @db.ObjectId
    chapterId           String        @db.ObjectId
    originalImageUrl    String // URL or path to the original image
    maskImageUrl        String? // URL or path to the mask image if used
    deletedTextImageUrl String? // URL or path to the text-deleted image
    userEditedImageUrl  String? // URL or path to the final user-edited image
    textBlocks          TextBlock[] // Relation to text blocks detected in the image
    editedBlocks        EditedBlock[] // Relation to edited text blocks created by the user

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

    translatedBlock TranslatedBlock[]
}

model TextBlock {
    id           String @id @default(auto()) @map("_id") @db.ObjectId
    pageId       String @db.ObjectId
    text         String // Extracted text in this block
    fontFamily   String // Detected or default font
    textColor    String // Detected text color
    outlineColor String // Detected outline color
    boundingPoly Json[] // Array of bounding polygons 
    language     String

    page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

    translatedBlock TranslatedBlock?
    EditedBlock     EditedBlock?
}

model TranslatedBlock {
    id           String    @id @default(auto()) @map("_id") @db.ObjectId
    pageId       String    @db.ObjectId
    text         String // Extracted text in this block
    fontFamily   String // Detected or default font
    textColor    String // Detected text color
    outlineColor String // Detected outline color
    boundingPoly Json[] // Array of bounding polygons 
    language     String
    textBlockId  String    @unique @db.ObjectId // Reference to the original text block
    page         Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
    textBlock    TextBlock @relation(fields: [textBlockId], references: [id], onDelete: Cascade)
}

model EditedBlock {
    id           String    @id @default(auto()) @map("_id") @db.ObjectId
    pageId       String    @db.ObjectId
    text         String // Edited text in this block
    fontFamily   String // Edited font
    textColor    String // Edited text color
    outlineColor String // Edited outline color
    boundingPoly Json[] // Array of bounding polygons 
    language     String
    textBlockId  String    @unique @db.ObjectId // Reference to the original text block
    page         Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
    textBlock    TextBlock @relation(fields: [textBlockId], references: [id], onDelete: Cascade)
}
