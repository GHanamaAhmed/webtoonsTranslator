name: Build and Deploy AWS SAM Application

on:
  push:
    branches:
      - main # Adjust the branch to trigger deployment

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout code
        uses: actions/checkout@v3 # Check out the repository code

      - name: Install Git LFS
        run: |
          sudo apt-get install git-lfs
          git lfs install

      - name: Pull LFS files
        run: |
          cd src/fonts/noto-sans/
          git lfs pull

      - name: Clear Docker system
        run: docker system prune -af

      - name: Delete huge unnecessary tools folder
        run: rm -rf /opt/hostedtoolcache

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: "3.x" # Use the appropriate Python version

      - name: Install AWS SAM CLI
        run: |
          pip install aws-sam-cli

      - name: Configure AWS credentials
        uses: aws-actions/configure-aws-credentials@v3
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: us-east-1 # Use the region you configured in your samconfig.toml

      - name: Build SAM application
        run: |
          sam build
          
      - name: Deploy SAM application
        run: |
          sam deploy --config-file samconfig.toml --no-confirm-changeset

      - name: Display the stack outputs
        run: |
          aws cloudformation describe-stacks --stack-name manhwavision --query 'Stacks[0].Outputs'
        env:
          AWS_ACCESS_KEY_ID: ${{ secrets.AWS_ACCESS_KEY_ID }}
          AWS_SECRET_ACCESS_KEY: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          AWS_REGION: us-east-1 # Ensure region matches your configuration
